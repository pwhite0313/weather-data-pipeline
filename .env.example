# Copy to .env and fill in the blanks. .env is gitignored; this file is not.
#   cp .env.example .env
# Never put real values here.

# ---- OpenWeather ----
# openweathermap.org, free tier
OPENWEATHER_API_KEY=

# ---- Airflow ----
# Your host UID, so container-written files are yours: id -u
AIRFLOW_UID=1000
# Generate each one fresh. Never copy them from an airflow.cfg.
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Others: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=
# Airflow 3 names, ignored by 2.8.1; set now so an upgrade does not start without them.
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=

# ---- Postgres warehouse (the local pipeline) ----
WAREHOUSE_USER=
WAREHOUSE_PASSWORD=
WAREHOUSE_DB=weather_db
WAREHOUSE_HOST=postgres-warehouse
WAREHOUSE_PORT=5432

# ---- Snowflake ----
# ORGNAME-ACCOUNTNAME, from:
#   SELECT CURRENT_ORGANIZATION_NAME(), CURRENT_ACCOUNT_NAME();
# Not the account locator in the URL. Underscores become hyphens.
SNOWFLAKE_ACCOUNT=your-org-your-account
# Created by setup/04_service_user.sql
SNOWFLAKE_USER=WEATHER_SVC
SNOWFLAKE_ROLE=WEATHER_ENGINEER
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
SNOWFLAKE_DATABASE=WEATHER_DB
# Relative to the repo root. See keys/README.md to generate the pair.
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/keys/rsa_key.p8
DBT_TARGET=snowflake

# ---- AWS ----
# AWS notation (us-east-2), not CURRENT_REGION() (AWS_US_EAST_2).
# Must match the Snowflake account region.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Warehouse for the Snowflake loader's COPY (SNOWFLAKE_WAREHOUSE above is dbt's).
SNOWFLAKE_LOAD_WAREHOUSE=LOAD_WH


# Airflow UI admin password (the compose default is admin; set a real one on any hosted box).
AIRFLOW_WWW_PASSWORD=

# ntfy.sh topic for failure alerts to a phone (random name; the name is the only secret).
# Subscribe to it in the ntfy app. Leave empty to log failures only.
NTFY_TOPIC=
