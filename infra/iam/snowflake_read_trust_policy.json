{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeAssumesThisRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "<STORAGE_AWS_IAM_USER_ARN from DESC INTEGRATION S3_WEATHER_INT>"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "<STORAGE_AWS_EXTERNAL_ID from DESC INTEGRATION S3_WEATHER_INT>"
        }
      }
    }
  ]
}
