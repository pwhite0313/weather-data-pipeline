{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadUnderWeatherPrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::pw-weather-2026/weather/*"
    },
    {
      "Sid": "ListWeatherPrefixAndLocateBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::pw-weather-2026",
      "Condition": {
        "StringLike": {
          "s3:prefix": "weather/*"
        }
      }
    }
  ]
}
